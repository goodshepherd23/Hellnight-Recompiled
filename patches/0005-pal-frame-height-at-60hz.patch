diff --git a/runtime/src/gpu.c b/runtime/src/gpu.c
index 18ed491b..8c795214 100644
--- a/runtime/src/gpu.c
+++ b/runtime/src/gpu.c
@@ -3268,6 +3268,25 @@ void gpu_get_display_info(GpuDisplayInfo* out) {
         /* The active canvas is a depth24 staging contract. Keep direct 15-bit
          * source rectangles independent from its origin and 576-row limit. */
         if (h > 512u) h = 512u;
+#ifdef PSX_DISPLAY_FILL_RANGE
+        /* Hellnight Recompiled, 60 Hz discs: the European game still draws
+         * PAL-height frames, but in NTSC mode it programs a ~216-line range,
+         * which cut off the Konami logo, title options and the save menu.
+         * Present the whole frame the game draws instead, never more: its
+         * drawing area gives the height (256 rows on the title screens, 240
+         * in gameplay, where the second buffer starts at row 240). The area
+         * passes through invalid values while the game swaps buffers, so the
+         * last valid height is kept. 24-bit FMVs are unchanged. */
+        if (!(video_mode & 1u) && !vres && vertical.range_set) {
+            static uint32_t frame_rows;
+            uint32_t drawn = draw_area_bottom >= draw_area_top
+                ? draw_area_bottom - draw_area_top + 1u : 0u;
+            if (drawn >= 200u && drawn <= 256u)
+                frame_rows = drawn;
+            if (frame_rows > h)
+                h = frame_rows;
+        }
+#endif
         screen_h = h;
         screen_origin_y = 0u;
         screen_source_skip_y = 0u;
